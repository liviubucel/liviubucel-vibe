---
import '@/style/main.css'
import ibmPlexNormal from '@/assets/fonts/ibm-plex-sans-latin-400-normal.woff2?url'
import ibmPlexMedium from '@/assets/fonts/ibm-plex-sans-latin-500-normal.woff2?url'
import ibmPlexSemiBold from '@/assets/fonts/ibm-plex-sans-latin-600-normal.woff2?url'
import ibmPlexBold from '@/assets/fonts/ibm-plex-sans-latin-700-normal.woff2?url'

import ModeManager from '@/components/mode/ModeManager.astro'
import CodeBlockIconsPlugin from '@/plugins/CodeBlockIconsPlugin.astro'
import ZoomableImagesPlugin from '@/plugins/ZoomableImagesPlugin.astro'
import config from '@/theme.config'
import { ClientRouter } from 'astro:transitions'

const preloadFonts = [
  ibmPlexNormal,
  ibmPlexMedium,
  ibmPlexSemiBold,
  ibmPlexBold
]

export interface Props {
  frontmatter: Partial<{
    title: string
    author: string
    description: string
    canonicalURL: string
    publishedDate: Date
    updatedDate?: Date
  }>
}
const { frontmatter }=Astro.props;
const author=frontmatter.author||config.author;
---

<!doctype html>
<html lang={Astro.url.pathname === '/ro' || Astro.url.pathname.startsWith('/ro/') ? 'ro' : config.locale} class={config.colorScheme || 'scheme-mono'}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/brand/lb-mark.png" />

    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={author} />
    <!-- Native Wix SEO (dashboard controlled): title, description, canonical,
         OG/Twitter, robots and JSON-LD injected by @wix/astro middleware.
         Dynamic Wix item pages forward resolved tags through this slot. -->
    <slot name="seo-tags" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Liviu Bucel — Wix Blog"
      href="/rss.xml"
    />

    {preloadFonts.map((font) => (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={font}
        crossorigin="anonymous"
      />
    ))}

    <ModeManager />
    <ClientRouter />
  </head>
  <body>
    <slot />
    <CodeBlockIconsPlugin />
    <ZoomableImagesPlugin />
  </body>
</html>
