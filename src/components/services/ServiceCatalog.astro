---
import PageLayout from '@/layouts/PageLayout.astro';
import {serviceOfferings,type Locale} from '@/lib/professional-services';
interface Props{locale:Locale}
const {locale}=Astro.props;
const ro=locale==='ro';
const prefix=ro?'/ro':'';
const frontmatter={
 title:ro?'Servicii de securitate și infrastructură':'Cybersecurity & infrastructure services',
 description:ro?'Servicii tehnice personalizate pentru protejarea site-urilor și infrastructurilor web':'Technical services for protecting websites, applications and infrastructure',
 activeHeaderLink:'Services',
 wide:true
};
---
<PageLayout {frontmatter}>
  <div class="not-prose">
    <div class="mt-3 mb-10 border-b border-current/15 pb-10 sm:mt-6 sm:mb-14 sm:pb-14">
      <p class="mb-4 flex items-center gap-2 text-sm font-semibold tracking-wide opacity-70">
        <span class="iconify tabler--shield-lock text-xl" aria-hidden="true"></span>
        {ro?'SECURITATE • INFRASTRUCTURĂ • CONSULTANȚĂ':'SECURITY • INFRASTRUCTURE • CONSULTING'}
      </p>
      <div class="grid items-end gap-8 md:grid-cols-[1.5fr_1fr]">
        <div>
          <h1 class="max-w-[16ch] text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
            {ro?'Soluții practice pentru sisteme mai sigure.':'Practical security for systems that matter.'}
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed opacity-80">
            {ro?'De la configurația Cloudflare până la evaluarea aplicațiilor și securizarea infrastructurii. Lucrăm cu obiective clare, verificări documentate și schimbări aprobate.':'From Cloudflare management to application reviews and infrastructure hardening. Clear scope, documented findings and authorised changes.'}
          </p>
        </div>
        <div class="rounded-sm border border-current/20 p-6">
          <p class="text-sm font-semibold uppercase tracking-wide opacity-70">{ro?'Ai o problemă concretă?':'Have a project in mind?'}</p>
          <p class="mt-3 text-base leading-relaxed">{ro?'Spune-mi ce vrei să protejezi și identificăm împreună următorul pas.':'Tell me what you want to protect and we can define the right next step.'}</p>
          <a class="mt-5 inline-flex items-center gap-2 rounded-sm bg-accent px-4 py-3 text-base font-semibold text-accent-bg transition duration-300 hover:opacity-75" href={prefix+'/contact/?service=security-assessment'}>
            {ro?'Discută proiectul':'Discuss your project'} <span class="iconify tabler--arrow-up-right text-xl" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </div>

    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
      <div><p class="text-sm font-semibold uppercase tracking-wider opacity-60">{ro?'SERVICII PROFESIONALE':'PROFESSIONAL SERVICES'}</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight">{ro?'Cum te pot ajuta':'Explore the services'}</h2></div>
      <p class="max-w-sm text-sm opacity-65">{ro?'Fiecare serviciu include scopul lucrării, etapele și rezultatele oferite.':'Each service explains its scope, process and deliverables.'}</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {serviceOfferings.map((offering,i)=>(
        <a href={prefix+'/services/'+offering.slug+'/'} class:list={['group flex min-w-0 flex-col justify-between rounded-sm border border-current/20 p-6 no-underline transition duration-300 ease-in-out hover:-translate-y-1 hover:border-current/60 focus-visible:outline-2 focus-visible:outline-offset-2',i===0?'sm:col-span-2':'']}>
          <div>
            <div class="mb-6 flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-sm border border-current/20">
                <span class={'iconify '+offering.icon+' text-3xl'} aria-hidden="true"></span>
              </span>
              <span class="iconify tabler--arrow-up-right text-2xl opacity-50 transition duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:opacity-100" aria-hidden="true"></span>
            </div>
            <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">{offering[locale].name}</h3>
            <p class="mt-3 max-w-2xl text-base leading-relaxed opacity-75">{offering[locale].lead}</p>
          </div>
          <p class="mt-7 flex items-center gap-2 border-t border-current/15 pt-4 text-sm font-semibold">{ro?'Vezi serviciul':'View service'} <span class="iconify tabler--arrow-right transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></span></p>
        </a>
      ))}
    </div>

    <section class="my-16 border-t border-current/20 pt-10">
      <h2 class="text-3xl font-semibold tracking-tight">{ro?'Un proces clar, fără surprize':'A clear and measured process'}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          [ro?'01 — Definire':'01 — Scope',ro?'Stabilim sistemele, obiectivele, accesul și acordul scris.':'Agree assets, objectives, access and written authorisation.'],
          [ro?'02 — Evaluare':'02 — Assess',ro?'Verificăm situația reală și documentăm constatările.':'Inspect the actual environment and record evidence.'],
          [ro?'03 — Implementare':'03 — Improve',ro?'Aplicăm măsurile aprobate sau propunem remedieri.':'Make agreed changes or recommend targeted fixes.'],
          [ro?'04 — Validare':'04 — Verify',ro?'Verificăm rezultatul și predăm concluziile.':'Validate the outcome and hand over clear findings.']
        ].map(step=>(
          <div><span class="font-semibold">{step[0]}</span><p class="mt-3 text-base leading-relaxed opacity-70">{step[1]}</p></div>
        ))}
      </div>
    </section>

    <section class="rounded-sm border border-current/25 p-7 sm:p-10">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <div><h2 class="text-2xl font-semibold">{ro?'Nu știi de unde să începi?':'Not sure where to start?'}</h2>
          <p class="mt-3 max-w-xl text-base opacity-75">{ro?'O scurtă discuție este suficientă pentru a identifica serviciul potrivit și limitele unei evaluări.':'Start with a brief discussion about the system, the risks and what a realistic assessment could cover.'}</p></div>
        <a href={prefix+'/contact/'} class="clickable inline-flex shrink-0 items-center gap-2 rounded-sm border border-current/40 px-5 py-3 text-base font-semibold">{ro?'Contactează-mă':'Get in touch'} <span class="iconify tabler--arrow-up-right text-xl"></span></a>
      </div>
    </section>
    <p class="my-8 text-sm leading-relaxed opacity-65">{ro?'Evaluările active necesită autorizare scrisă. Serviciile Cloudflare sunt independente, nu un program oficial de servicii profesionale Cloudflare.':'Active assessments require written authorisation. Cloudflare-related services are independent and not official Cloudflare Professional Services.'}</p>
  </div>
</PageLayout>
