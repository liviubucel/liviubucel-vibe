---
const path=Astro.url.pathname;
const romanian=path==='/ro'||path.startsWith('/ro/');
const normalized=romanian?(path.slice(3)||'/'):path;
const en=normalized;
const ro='/ro'+(normalized==='/'?'/':normalized);
---
<details class="relative text-base" id="locale-switch">
  <summary class="clickable flex cursor-pointer list-none items-center gap-2 rounded-sm px-2 py-2 transition-colors duration-300 hover:text-accent focus-visible:outline focus-visible:outline-2" aria-label={romanian?'Alege limba':'Choose language'} title={romanian?'Alege limba':'Choose language'}>
    <span class="iconify tabler--world text-3xl sm:text-4xl" aria-hidden="true"></span>
    <span class="text-base font-semibold tracking-wide">{romanian?'RO':'EN'}</span>
    <span class="iconify tabler--chevron-down text-base" aria-hidden="true"></span>
  </summary>
  <div class="absolute right-0 bottom-full z-30 mb-2 min-w-40 rounded-sm border border-current/20 bg-accent-bg px-4 py-3 shadow-lg">
    <a class="clickable block py-2 text-base" href={en} lang="en" hreflang="en" aria-current={!romanian?'page':undefined}>English</a>
    <a class="clickable block py-2 text-base" href={ro} lang="ro" hreflang="ro" aria-current={romanian?'page':undefined}>Română</a>
  </div>
</details>
