---
import PageLayout from '@/layouts/PageLayout.astro';
import {projectStories} from '@/lib/project-stories';
import TagsBar from '@/components/TagsBar.astro';
import {resolveTags} from '@/util/tags';
import {getNativeProject,projectTechnologies,projectExternalLink} from '@/lib/wix-portfolio';
export const prerender=false;
let unavailable=false;
let project;
try{project=await getNativeProject(Astro.params.id||'')}catch(e){unavailable=true;console.error('[nordlys-wix-project]',e instanceof Error?e.message:'Portfolio unavailable')}
if(!project)Astro.response.status=unavailable?503:404;
const story=projectStories[project?.slug||''];
const narrative=story?.en;
const technologies=(project?projectTechnologies(project):'')?.split(',').map(x=>x.trim()).filter(Boolean)||[];
const link=project?projectExternalLink(project):undefined;
const frontmatter={title:project?.title||'Project not found',activeHeaderLink:'Projects',description:project?.description||'Technical project by Liviu Bucel'};
---
<PageLayout {frontmatter}>
  <div slot="top" class="mt-4">
    <a class="clickable flex w-fit items-center gap-1" href="/projects/">
      <span class="iconify tabler--arrow-left text-xl"></span>
      Back to all projects
    </a>
  </div>
  {project?(
    <>
      <h1 class="mt-2 mb-2 sm:my-4">{project.title}</h1>
      <TagsBar tags={resolveTags(technologies)}/>
      <p>{project.description}</p>
      {story&&<figure class="mt-8">
        <a href={story.screenshot} target="_blank" rel="noopener noreferrer"><img src={story.screenshot} alt={story.imageCaption.en} width="1280" height="800" loading="lazy" class="w-full rounded-sm border border-current/20" /></a>
        <figcaption class="text-sm opacity-70">{story.imageCaption.en}</figcaption>
      </figure>}
      {narrative&&<>
        <section><h2>Problem to solve</h2><p>{narrative.problem}</p></section>
        <section><h2>Design & architecture</h2><p>{narrative.approach}</p></section>
        <section><h2>What it provides</h2><ul>{narrative.outcomes.map(x=><li>{x}</li>)}</ul></section>
        <section><h2>Security considerations</h2><ul>{narrative.security.map(x=><li>{x}</li>)}</ul></section>
      </>}
      {story?.repository&&<p><a class="clickable" href={story.repository} rel="noopener noreferrer" target="_blank">Source code on GitHub</a></p>}
      {story?.demo&&<p><a class="clickable" href={story.demo} rel="noopener noreferrer" target="_blank">Live website / demo</a></p>}
      {project.details?.filter(d=>d.label!=='Technologies'&&d.label!=='Project link').map(detail=>(
        <section>
          {detail.label&&<h2>{detail.label}</h2>}
          {detail.text&&<p class="whitespace-pre-line">{detail.text}</p>}
          {detail.link?.url?.startsWith('https://')&&<p><a href={detail.link.url} rel="noopener noreferrer" target="_blank">{detail.link.text||'Open link'}</a></p>}
        </section>
      ))}
      {link&&<p><a class="clickable" href={link} rel="noopener noreferrer" target="_blank">Open project <span class="iconify tabler--external-link align-middle"></span></a></p>}
    </>
  ):<p>{unavailable?'Portfolio temporarily unavailable.':'Project not found.'}</p>}
</PageLayout>
