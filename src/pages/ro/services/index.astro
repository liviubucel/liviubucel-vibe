---
import PageLayout from '@/layouts/PageLayout.astro';
import {serviceOfferings} from '@/lib/professional-services';
const frontmatter={title:"Servicii profesionale",description:"Asistență practică pentru securitate cibernetică și infrastructură web, cu obiective clare, autorizare scrisă și rezultate documentate.",activeHeaderLink:'Services'};
---
<PageLayout {frontmatter}>
  <h1>Servicii profesionale</h1>
  <p>Asistență practică pentru securitate cibernetică și infrastructură web, cu obiective clare, autorizare scrisă și rezultate documentate.</p>
  <h2>Cu ce te pot ajuta</h2>
  <div class="flex flex-col gap-2">
    {serviceOfferings.map(service=>(
      <section class="mb-2">
        <h3><span class={'iconify '+service.icon+' mr-2 inline-block align-middle'} aria-hidden="true"></span>
          <a href={'/ro/services/'+service.slug+'/'}>{service.ro.name}</a>
        </h3>
        <p>{service.ro.lead}</p>
        <p><a class="clickable" href={'/ro/services/'+service.slug+'/'}>Detalii despre serviciu <span class="iconify tabler--arrow-up-right align-middle"></span></a></p>
      </section>
    ))}
  </div>
  <h2>Cum lucrăm</h2>
    <section><h3>01 — Definire</h3><p>Stabilim sistemele vizate, obiectivele, accesul și autorizarea explicită.</p></section>
  <section><h3>02 — Analiză</h3><p>Documentăm configurația și verificăm observațiile, fără presupuneri neconfirmate.</p></section>
  <section><h3>03 — Remediere</h3><p>Aplicăm modificări aprobate sau întocmim recomandări tehnice concrete.</p></section>
  <section><h3>04 — Verificare</h3><p>Validăm rezultatul și documentăm configurația predată.</p></section>
  <p class="text-sm opacity-75">Servicii independente; nu reprezintă o ofertă oficială Cloudflare Professional Services și nu implică o certificare Cloudflare.</p>
  <p class="font-medium">Testarea activă se face exclusiv cu acord scris și domeniu definit.</p>
  <p><a class="clickable" href="/ro/contact/">Discută proiectul</a> · <a class="clickable" href="/ro/projects/">Vezi proiectele</a></p>
</PageLayout>
