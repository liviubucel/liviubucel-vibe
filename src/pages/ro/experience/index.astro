---
import PageLayout from '@/layouts/PageLayout.astro';
import ToC from '@/components/ToC.astro';
const frontmatter={title:"CV și experiență",description:"Parcursul meu combină suportul IT și infrastructura web cu specializarea în securitate cibernetică, investigații digitale și operațiuni de securitate.",activeHeaderLink:'Resume',scrollProgress:true};
const headings=[{"depth": 2, "slug": "education", "text": "Educație"}, {"depth": 2, "slug": "experience", "text": "Experiență profesională"}, {"depth": 2, "slug": "hands-on", "text": "Practică în securitate"}, {"depth": 2, "slug": "skills", "text": "Competențe tehnice"}, {"depth": 2, "slug": "learning", "text": "Formare și acreditări"}, {"depth": 2, "slug": "cv", "text": "CV și contact"}];
---
<PageLayout {frontmatter}>
  <div slot="aside" class="border-accent mt-24 hidden border-r pr-4 opacity-75 transition duration-500 ease-in-out hover:opacity-100 2xl:block"><ToC {headings} open /></div>
  <h1>CV și experiență</h1>
  <p>Parcursul meu combină suportul IT și infrastructura web cu specializarea în securitate cibernetică, investigații digitale și operațiuni de securitate.</p>
  <div class="mt-6 w-fit rounded-sm border 2xl:hidden"><ToC {headings}/></div>
  <article>
    <section id="resume-education"><h2 id="education">Educație</h2><p><strong>BSc (Hons) Cyber Security</strong> — De Montfort University, Leicester, Regatul Unit</p><p>2024–2027 (absolvire estimată). Studiile și laboratoarele includ securitatea rețelelor, testare autorizată, analiza incidentelor, investigații digitale și securitatea sistemelor cyber-fizice.</p></section>
    <section id="resume-experience"><h2 id="experience">Experiență profesională</h2><h3>ZebraByte — infrastructură web și suport tehnic</h3><p class="opacity-75">Aprilie 2022 – Ianuarie 2024 · Regatul Unit</p><p>Suport pentru hosting, DNS, certificate TLS, WordPress și livrarea mesajelor email. Activitate cu cPanel, Cloudflare, depanare tehnică și controale de protecție.</p><h3>Intact Media Group — tehnician IT</h3><p class="opacity-75">Noiembrie 2019 – Septembrie 2020 · București, România</p><p>Suport IT de prim nivel pentru stații Windows, aplicații, conectivitate, email și escaladarea problemelor de infrastructură într-un mediu media.</p></section>
    <section id="resume-hands-on"><h2 id="hands-on">Practică în securitate</h2><p><strong>Securitatea aplicațiilor:</strong> laboratoare controlate cu Burp Suite, metodologia OWASP, Nmap și evaluări web autorizate.</p><p><strong>Analiza rețelelor:</strong> captură și interpretare de trafic cu Wireshark, identificarea anomaliilor și a configurărilor greșite.</p><p><strong>Infrastructură și cloud:</strong> DNS, TLS, Cloudflare WAF, limitarea cererilor, antete HTTP și protecția accesului.</p><p><strong>Dezvoltare:</strong> Linux/Windows, scripting Python/Bash, TypeScript și aplicații tehnice documentate în <a href="/ro/projects/">Proiecte</a>.</p></section>
    <section id="resume-skills"><h2 id="skills">Competențe tehnice</h2><p><strong>Securitate:</strong> analiza vulnerabilităților, elemente de răspuns la incidente, păstrarea dovezilor, analiza amenințărilor și interpretarea logurilor.</p><p><strong>Rețelistică:</strong> DNS, TCP/IP, TLS/HTTPS, rutare, firewall și analiza traficului.</p><p><strong>Platforme:</strong> Linux, Windows, Cloudflare, hosting, GitHub și aplicații cloud.</p><p><strong>Instrumente:</strong> Nmap, Wireshark, Burp Suite, Kali Linux, Python, Bash. Vezi <a href="/ro/tools/">cum le folosesc</a>.</p></section>
    <section id="resume-learning"><h2 id="learning">Formare și acreditări</h2><p>Îmi dezvolt competențele prin studiile universitare, laboratoare și practică tehnică. Pagina <a href="/ro/accreditations/">Acreditări și formare</a> separă activitățile documentate de certificările aflate în curs.</p></section>
    <section id="resume-cv"><h2 id="cv">CV și contact</h2><p>CV-ul actualizat poate fi solicitat direct. Pentru oportunități profesionale și proiecte autorizate, <a href="/ro/contact/">contactează-mă</a> sau vizitează profilul de <a href="https://www.linkedin.com/in/liviubucel/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p></section>
  </article>
</PageLayout>
